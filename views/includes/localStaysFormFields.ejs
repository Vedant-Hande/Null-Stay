<%# locals: listing (optional, for edit) %>
<% const L = typeof localStays !== 'undefined' ? localStays : {}; %>
<% const listingRef = typeof listing !== 'undefined' ? listing : {}; %>
<% const selectedCity = listingRef.city || ''; %>
<% const selectedArea = listingRef.area || ''; %>

<div class="flex flex-col gap-5">
  <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest border-b border-gray-100 pb-2">
    City &amp; locality
  </h3>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="border border-gray-300 rounded-xl overflow-hidden focus-within:border-black focus-within:ring-1 focus-within:ring-black transition shadow-sm bg-gray-50/50">
      <div class="relative px-4 py-2">
        <label for="listingCity" class="absolute text-[10px] uppercase font-bold text-gray-500 top-2">City *</label>
        <select id="listingCity" name="listing[city]"
          class="w-full pt-5 pb-1 outline-none text-gray-900 bg-transparent font-medium">
          <option value="" disabled <%= !selectedCity ? 'selected' : '' %>>Select city</option>
          <% (L.CITIES || []).forEach((c) => { %>
            <option value="<%= c.id %>" <%= selectedCity === c.id ? 'selected' : '' %>><%= c.label %></option>
          <% }) %>
        </select>
        <div class="invalid-feedback">City is required.</div>
      </div>
    </div>

    <div class="border border-gray-300 rounded-xl overflow-hidden focus-within:border-black focus-within:ring-1 focus-within:ring-black transition shadow-sm bg-gray-50/50">
      <div class="relative px-4 py-2">
        <label for="listingArea" class="absolute text-[10px] uppercase font-bold text-gray-500 top-2">Area / locality</label>
        <select id="listingArea" name="listing[area]"
          class="w-full pt-5 pb-1 outline-none text-gray-900 bg-transparent font-medium"
          data-initial-area="<%= selectedArea %>">
          <option value="">Select area (optional)</option>
        </select>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="border border-gray-300 rounded-xl overflow-hidden focus-within:border-black focus-within:ring-1 focus-within:ring-black transition shadow-sm bg-gray-50/50">
      <div class="relative px-4 py-2">
        <label for="propertyType" class="absolute text-[10px] uppercase font-bold text-gray-500 top-2">Property type *</label>
        <select id="propertyType" name="listing[propertyType]" required
          class="w-full pt-5 pb-1 outline-none text-gray-900 bg-transparent font-medium">
          <% (L.PROPERTY_TYPES || []).forEach((p) => { %>
            <option value="<%= p.id %>" <%= (listingRef.propertyType || 'private_room') === p.id ? 'selected' : '' %>><%= p.label %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="border border-gray-300 rounded-xl overflow-hidden focus-within:border-black focus-within:ring-1 focus-within:ring-black transition shadow-sm bg-gray-50/50">
      <div class="relative px-4 py-2">
        <label for="country" class="absolute text-[10px] uppercase font-bold text-gray-500 top-2">Country</label>
        <input type="text" id="country" name="listing[country]" required maxlength="50"
          value="<%= listingRef.country || 'India' %>"
          class="w-full pt-5 pb-1 outline-none text-gray-900 bg-transparent font-medium" />
      </div>
    </div>
  </div>

  <div class="border border-gray-300 rounded-xl overflow-hidden focus-within:border-black focus-within:ring-1 focus-within:ring-black transition shadow-sm bg-gray-50/50">
    <div class="relative px-4 py-2">
      <label for="location" class="absolute text-[10px] uppercase font-bold text-gray-500 top-2">Street / landmark *</label>
      <input type="text" id="location" name="listing[location]" required maxlength="100"
        value="<%= listingRef.location || '' %>"
        placeholder="e.g. Near College Road, main market"
        class="w-full pt-5 pb-1 outline-none text-gray-900 bg-transparent font-medium" />
      <div class="invalid-feedback">Location is required.</div>
    </div>
  </div>
</div>

<script type="application/json" id="areasByCityData"><%- JSON.stringify(L.AREAS_BY_CITY || {}) %></script>
