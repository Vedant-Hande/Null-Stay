<div id="shareModal" class="fixed inset-0 z-[120] hidden" aria-hidden="true">
  <div id="shareModalBackdrop" class="absolute inset-0 bg-black/40"></div>
  <div class="relative h-full w-full flex items-end sm:items-center justify-center p-4">
    <div id="shareModalPanel" class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
        <div>
          <div class="text-sm font-semibold text-gray-900">Share</div>
          <div id="shareModalTitle" class="text-xs text-gray-500 mt-0.5 truncate"></div>
        </div>
        <button type="button" id="shareModalClose" class="w-10 h-10 rounded-full hover:bg-gray-100 flex items-center justify-center text-lg transition" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="p-5">
        <div class="grid grid-cols-2 gap-3">
          <a id="shareLinkWhatsapp" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-gray-200 hover:bg-gray-50 transition">
            <span class="w-9 h-9 rounded-full bg-green-50 text-green-700 flex items-center justify-center"><i class="fa-brands fa-whatsapp"></i></span>
            <span class="text-sm font-semibold text-gray-900">WhatsApp</span>
          </a>
          <a id="shareLinkFacebook" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-gray-200 hover:bg-gray-50 transition">
            <span class="w-9 h-9 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center"><i class="fa-brands fa-facebook-f"></i></span>
            <span class="text-sm font-semibold text-gray-900">Facebook</span>
          </a>
          <a id="shareLinkX" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-gray-200 hover:bg-gray-50 transition">
            <span class="w-9 h-9 rounded-full bg-gray-100 text-gray-900 flex items-center justify-center"><i class="fa-brands fa-x-twitter"></i></span>
            <span class="text-sm font-semibold text-gray-900">X</span>
          </a>
          <a id="shareLinkLinkedin" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-4 py-3 rounded-xl border border-gray-200 hover:bg-gray-50 transition">
            <span class="w-9 h-9 rounded-full bg-sky-50 text-sky-700 flex items-center justify-center"><i class="fa-brands fa-linkedin-in"></i></span>
            <span class="text-sm font-semibold text-gray-900">LinkedIn</span>
          </a>
        </div>

        <div class="mt-4">
          <button type="button" id="shareCopyBtn" class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-gray-900 text-white font-semibold hover:bg-black transition">
            <i class="fa-regular fa-copy"></i>
            Copy link
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
