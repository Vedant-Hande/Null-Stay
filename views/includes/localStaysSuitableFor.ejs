<%# locals: listing (optional) %>
<% const L = typeof localStays !== 'undefined' ? localStays : {}; %>
<% const listingRef = typeof listing !== 'undefined' ? listing : {}; %>
<% const current = listingRef.suitableFor || []; %>

<div class="flex flex-col gap-5">
  <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest border-b border-gray-100 pb-2">
    Suitable for
  </h3>
  <p class="text-xs text-gray-500 -mt-2">Select who can stay (be accurate — shown on listing).</p>
  <div class="grid grid-cols-2 gap-3">
    <% (L.SUITABLE_FOR_OPTIONS || []).forEach((opt) => { %>
      <label class="flex items-center gap-3 p-3 border border-gray-200 rounded-xl cursor-pointer hover:bg-gray-50 has-[:checked]:border-black transition">
        <input type="checkbox" name="listing[suitableFor][]" value="<%= opt.id %>"
          <%= current.includes(opt.id) ? 'checked' : '' %>
          class="w-4 h-4 accent-black rounded" />
        <span class="text-sm font-medium text-gray-700"><%= opt.label %></span>
      </label>
    <% }) %>
  </div>
</div>
